#!/bin/sh
# Docs: .claude/skills/quickshell/references/linting.md
set -eu

usage() {
	printf '%s\n' "usage: quickshell-qmllint [--root <shell-root>] [--qml-root <path>] [--qmllint <cmd>] [qml-file ...]" >&2
	exit 2
}

root=
qmllint_cmd=
extra_roots=
files=

while [ "$#" -gt 0 ]; do
	case "$1" in
	--root)
		[ "$#" -ge 2 ] || usage
		root=$2
		shift 2
		;;
	--qml-root)
		[ "$#" -ge 2 ] || usage
		extra_roots=${extra_roots:+$extra_roots
}$2
		shift 2
		;;
	--qmllint)
		[ "$#" -ge 2 ] || usage
		qmllint_cmd=$2
		shift 2
		;;
	--)
		shift
		break
		;;
	-*)
		usage
		;;
	*)
		files=${files:+$files
}$1
		shift
		;;
	esac
done

while [ "$#" -gt 0 ]; do
	files=${files:+$files
}$1
	shift
done

find_qmllint() {
	if [ -n "$qmllint_cmd" ]; then
		printf '%s\n' "$qmllint_cmd"
		return 0
	fi
	for cmd in qmllint-qt6 qmllint /usr/lib64/qt6/bin/qmllint /usr/lib/qt6/bin/qmllint; do
		command -v "$cmd" >/dev/null 2>&1 || continue
		printf '%s\n' "$cmd"
		return 0
	done
	printf '%s\n' "qmllint not found. Install qt6 declarative tooling, e.g. qt6-qtdeclarative-devel, qt6-declarative, or qt6-declarative-dev-tools." >&2
	exit 127
}

abs_path() {
	path=$1
	if [ -d "$path" ]; then
		(cd "$path" && pwd)
	else
		dir=$(dirname -- "$path")
		base=$(basename -- "$path")
		printf '%s/%s\n' "$(cd "$dir" && pwd)" "$base"
	fi
}

find_shell_qml_above() {
	dir=$1
	while :; do
		if [ -f "$dir/shell.qml" ]; then
			printf '%s\n' "$dir"
			return 0
		fi
		[ "$dir" != / ] || return 1
		dir=$(dirname -- "$dir")
	done
}

find_root() {
	if [ -n "$root" ]; then
		abs_path "$root"
		return 0
	fi
	find_shell_qml_above "$PWD" && return 0
	if [ -n "$files" ]; then
		first=$(printf '%s\n' "$files" | sed -n '1p')
		find_shell_qml_above "$(dirname -- "$(abs_path "$first")")" && return 0
	fi
	printf '%s\n' "could not find shell.qml; pass --root <shell-root>" >&2
	exit 2
}

discover_qml_roots() {
	[ -z "$extra_roots" ] || printf '%s\n' "$extra_roots"
	for path in /usr/lib64/qt6/qml /usr/lib/qt6/qml /usr/local/lib64/qt6/qml /usr/local/lib/qt6/qml; do
		[ ! -d "$path" ] || printf '%s\n' "$path"
	done
	! command -v qmake6 >/dev/null 2>&1 || qmake6 -query QT_INSTALL_QML 2>/dev/null || true
}

make_qmldir_for_module() {
	module=$1
	module_path=$(printf '%s\n' "$module" | sed 's/^qs//; s/^\.//; s/\./\//g')
	source_dir=$project_root${module_path:+/$module_path}
	target_dir=$tmp/qs${module_path:+/$module_path}
	[ -d "$source_dir" ] || return 0
	mkdir -p "$target_dir"
	printf 'module %s\n' "$module" >"$target_dir/qmldir"

	find "$source_dir" -maxdepth 1 -type f -name '[A-Z]*.qml' | sort |
		while IFS= read -r qml; do
			name=$(basename -- "$qml" .qml)
			file=$(basename -- "$qml")
			ln -sf "$qml" "$target_dir/$file"
			kind=
			sed -n '1,8p' "$qml" | grep -Eq '^[[:space:]]*pragma[[:space:]]+Singleton([[:space:]]|$)' && kind='singleton '
			printf '%s%s 1.0 %s\n' "$kind" "$name" "$file" >>"$target_dir/qmldir"
		done
}

qmllint=$(find_qmllint)
project_root=$(find_root)

[ -n "$files" ] || files=$(find "$project_root" -type f -name '*.qml' | sort)

[ -n "$files" ] || {
	printf '%s\n' "no QML files found" >&2
	exit 2
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

imports=$(
	printf '%s\n' "$files" |
		while IFS= read -r file; do
			[ -f "$file" ] || continue
			sed -n 's/^[[:space:]]*import[[:space:]]\+\(qs\(\.[A-Za-z0-9_]\+\)*\)\([[:space:]].*\)\{0,1\}$/\1/p' "$file"
		done |
		sort -u
)

[ -z "$imports" ] || printf '%s\n' "$imports" |
	while IFS= read -r module; do
		make_qmldir_for_module "$module"
	done

qml_roots=$(discover_qml_roots | awk 'NF && !seen[$0]++')
build_dirs=
set --

if [ -n "$qml_roots" ]; then
	while IFS= read -r qml_root; do
		set -- "$@" -I "$qml_root"
		build_dirs=${build_dirs:+$build_dirs:}$qml_root
	done <<EOF
$qml_roots
EOF
fi

set -- "$@" -I "$tmp" -I "$project_root"

export QML_IMPORT_PATH="$project_root"
[ -z "$build_dirs" ] || export QMLLS_BUILD_DIRS="$build_dirs"

while IFS= read -r file; do
	set -- "$@" "$file"
done <<EOF
$files
EOF

exec "$qmllint" "$@"
