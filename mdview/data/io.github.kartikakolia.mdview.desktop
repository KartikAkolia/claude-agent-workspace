[Desktop Entry]
Type=Application
Name=mdview
GenericName=Markdown Viewer
Comment=Read and edit Markdown files in the system theme
Exec=mdview %F
Icon=text-markdown
Terminal=false
MimeType=text/markdown;text/x-markdown;
Categories=Utility;TextEditor;GTK;
Keywords=markdown;md;viewer;editor;
StartupNotify=true
