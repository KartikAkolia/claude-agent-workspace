#!/usr/bin/env bash
# shellcheck shell=bash
# pacman scriptlet: reapply the settings folder's packaged group and modes on every install and
# upgrade (pacman keeps an existing folder's mode). Keep _xppen_confgroup equal to PKGBUILD's _confgroup.
_xppen_confgroup=wheel

_xppen_fix_conf() {
	local dir=/usr/lib/pentablet/conf/xppen name file status=0
	if [[ ! -d $dir || -L $dir ]]; then
		echo "xppen-tablet: $dir is missing or not a folder; permissions not set" >&2
		return 1
	fi
	# Lock the folder before checking its files, so nobody outside the group can swap one in between.
	chown root:"$_xppen_confgroup" "$dir" && chmod 2775 "$dir" || return 1
	for name in config.xml dialogpos.ini language.ini name_config.ini; do
		file=$dir/$name
		[[ -e $file || -L $file ]] || continue
		if [[ -L $file || ! -f $file ]] || (($(stat -c %h -- "$file") != 1)); then
			echo "xppen-tablet: skipped $file: not a plain file; check it, then reinstall" >&2
			status=1
			continue
		fi
		chown root:"$_xppen_confgroup" "$file" && chmod 0664 "$file" || status=1
	done
	return "$status"
}

post_install() { _xppen_fix_conf; }
post_upgrade() { _xppen_fix_conf; }
