#!/usr/bin/env bash
# Pulls ~kartik/build/wordcraft, and if upstream moved, rebuilds and
# reinstalls the wordcraft package from ~kartik/build/wordcraft-pkg/PKGBUILD.
# Run as root by wordcraft-update.service (odd days of the month via
# wordcraft-update.timer). Only `pacman -U` runs as root: git and makepkg
# (which runs cargo in its build()) run as kartik through runuser with a clean
# environment. The package root installs is still one kartik built, so this
# trusts that account as much as sudo already does.
#
# `touch ~kartik/build/wordcraft-pkg/HOLD` pauses updates, e.g. after rolling
# back with pacman -U on the previously installed package kept there (each run
# keeps only the new package and the one it replaced); otherwise the next run
# would reinstall the newer one. Remove HOLD to resume.
#
# Don't run makepkg by hand in the package directory while this is running:
# the lock below only stops two runs of this script overlapping.
#
# Installed to /usr/local/bin/wordcraft-update (root:root 0755); the source
# copy lives beside the PKGBUILD. Logs: journalctl -u wordcraft-update.
# The `bash -c '...'` snippets below expand $1 etc. in the inner shell.
# shellcheck disable=SC2016
set -euo pipefail

user=kartik
home=/home/kartik
src="$home/build/wordcraft"
pkgdir="$home/build/wordcraft-pkg"

log() { printf 'wordcraft-update: %s\n' "$*"; }

if [ "$(id -u)" -ne 0 ]; then
	log 'must run as root' >&2
	exit 1
fi

if [ -e "$pkgdir/HOLD" ]; then
	log "$pkgdir/HOLD exists, updates paused"
	exit 0
fi

exec 9>/run/lock/wordcraft-update.lock
if ! flock -n 9; then
	log 'another run is in progress, skipping'
	exit 0
fi

# 9>&-: children (git's detached auto-gc in particular) mustn't inherit the
# lock and keep holding it after this script exits.
as_user() {
	runuser -u "$user" -- env -i HOME="$home" USER="$user" LOGNAME="$user" \
		PATH=/usr/local/bin:/usr/bin LANG=C.UTF-8 "$@" 9>&-
}

# Retry only the network step: a catch-up run right after resume can start
# before Wi-Fi reconnects, and network-online.target doesn't wait for that
# (it was reached at boot). The merge below fails at once on anything
# permanent (diverged upstream, local edits).
for attempt in $(seq 10); do
	if as_user git -C "$src" fetch --quiet; then
		break
	fi
	if [ "$attempt" -eq 10 ]; then
		log 'git fetch kept failing, giving up until the next run' >&2
		exit 1
	fi
	log "git fetch failed (attempt $attempt/10), retrying in 60s"
	sleep 60
done
if ! as_user git -C "$src" merge --ff-only --quiet '@{upstream}'; then
	log "can't fast-forward $src (local edits or diverged upstream); updates blocked until fixed by hand" >&2
	exit 1
fi

# pkgver() lives in the PKGBUILD; source it as kartik, never as root.
want="$(as_user bash -c 'set -e; cd "$1"; error() { printf "%s\n" "$*" >&2; }
	source ./PKGBUILD; v="$(pkgver)"; printf "%s-%s\n" "$v" "$pkgrel"' _ "$pkgdir")"
have="$(pacman -Q wordcraft 2>/dev/null | awk '{ print $2 }' || true)"
if [ "$want" = "$have" ]; then
	log "$have already installed, nothing to do"
	exit 0
fi
log "updating ${have:-none} -> $want"

as_user bash -c 'cd "$1" && makepkg -f --noconfirm' _ "$pkgdir"
pkg="$(as_user bash -c 'cd "$1" && makepkg --packagelist' _ "$pkgdir")"

if [ ! -f "$pkg" ] || [ -L "$pkg" ] || [ "$(stat -c %U "$pkg")" != "$user" ]; then
	log "unexpected package file ${pkg@Q}" >&2
	exit 1
fi

# Checked again here: HOLD may have been created during an hour-long build.
if [ -e "$pkgdir/HOLD" ]; then
	log "$pkgdir/HOLD appeared during the build; $pkg is built but not installed"
	exit 0
fi

# Retry the install itself, only while pacman reports the database lock, so
# another pacman taking it can't fail a finished build. Give up after 30
# minutes, which also covers a stale lock left by a crash.
err="$(mktemp)"
trap 'rm -f "$err"' EXIT
for attempt in $(seq 60); do
	# LC_ALL=C keeps the message grepped below untranslated.
	if LC_ALL=C pacman -U --noconfirm "$pkg" 2>"$err"; then
		cat "$err" >&2
		break
	fi
	cat "$err" >&2
	if ! grep -q 'unable to lock database' "$err" || [ "$attempt" -eq 60 ]; then
		log "pacman -U failed; $pkg is built, install it by hand" >&2
		exit 1
	fi
	log 'pacman database is locked, retrying in 30s'
	sleep 30
done

# Keep only this package and the one it replaced, so `pacman -U` can roll
# back to what was actually running. In the package's own directory, which
# follows PKGDEST if that's ever set; any PKGEXT compression.
as_user bash -c 'cd "$1" || exit 1
	for f in wordcraft-*.pkg.tar*; do
		[ -f "$f" ] && [ "$f" != "$2" ] || continue
		if [ -n "$3" ]; then case "$f" in "$3"*) continue ;; esac; fi
		rm -f -- "$f"
	done' _ "$(dirname "$pkg")" "$(basename "$pkg")" "${have:+wordcraft-$have-x86_64.pkg.tar}"

log "installed $want"
