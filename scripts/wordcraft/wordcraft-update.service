[Unit]
Description=Rebuild and reinstall WordCraft from ~kartik/build/wordcraft
Documentation=file:///home/kartik/build/wordcraft-pkg/wordcraft-update
Wants=network-online.target
After=network-online.target
# Don't start an hour-long release build on battery.
ConditionACPower=true

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wordcraft-update
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
# A cold release build at idle priority can take well over an hour.
TimeoutStartSec=4h
