[Unit]
Description=Rebuild and reinstall the *Craft apps built from ~kartik/build
Documentation=file:///usr/local/bin/craft-update
Wants=network-online.target
After=network-online.target
# Don't start hour-long release builds on battery.
ConditionACPower=true

[Service]
Type=oneshot
# One after another, under one lock, so the builds never compete. Each app
# is ~kartik/build/<app> with its PKGBUILD in ~kartik/build/<app>-pkg.
ExecStart=/usr/local/bin/craft-update wordcraft pdfcraft deckcraft
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
# A cold release build at idle priority can take well over an hour, and
# this runs up to three in a row.
TimeoutStartSec=8h
