#!/usr/bin/env bash
# Lints staged markdown with mdl and checks local cross-references for rot;
# validates staged JSON/YAML config parses cleanly; and runs
# lint-bash.sh/lint-python.sh over staged bash and Python files, before
# allowing a commit. Skips the read-only ChrisTitusTech reference clones and
# vendored/tool-generated content (see AGENTS.md non-negotiable #1).
# Config: ../.mdlrc, ../.mdl_style.rb
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

exclude_dirs=(dwm-titus-main linutil-main titus-ai-main website-master winutil-main)

is_reference_clone() {
	local f="$1" dir
	for dir in "${exclude_dirs[@]}"; do
		case "$f" in
		"$dir"/*) return 0 ;;
		esac
	done
	return 1
}

mapfile -t staged_md < <(git diff --cached --name-only --diff-filter=ACMR -- '*.md')
md_files=()
for f in "${staged_md[@]}"; do
	skip=0
	case "$f" in
	.*/*) skip=1 ;;
	*/node_modules/*) skip=1 ;;
	esac
	is_reference_clone "$f" && skip=1
	[ "$skip" -eq 0 ] && [ -f "$f" ] && md_files+=("$f")
done

mapfile -t staged_config < <(git diff --cached --name-only --diff-filter=ACMR -- '*.json' '*.yml' '*.yaml')
config_files=()
for f in "${staged_config[@]}"; do
	skip=0
	case "$f" in
	*/node_modules/*) skip=1 ;;
	esac
	is_reference_clone "$f" && skip=1
	[ "$skip" -eq 0 ] && [ -f "$f" ] && config_files+=("$f")
done

# Bash scripts aren't reliably *.sh (e.g. .githooks/pre-commit has no
# extension), so find them by shebang instead of extension.
mapfile -t staged_all < <(git diff --cached --name-only --diff-filter=ACMR)
bash_files=()
for f in "${staged_all[@]}"; do
	skip=0
	case "$f" in
	*/node_modules/*) skip=1 ;;
	esac
	is_reference_clone "$f" && skip=1
	[ "$skip" -eq 1 ] && continue
	[ -f "$f" ] || continue
	IFS= read -r first_line <"$f" 2>/dev/null || continue
	case "$first_line" in
	'#!'*bash) bash_files+=("$f") ;;
	esac
done

mapfile -t staged_py < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
python_files=()
for f in "${staged_py[@]}"; do
	skip=0
	case "$f" in
	*/node_modules/*) skip=1 ;;
	esac
	is_reference_clone "$f" && skip=1
	[ "$skip" -eq 0 ] && [ -f "$f" ] && python_files+=("$f")
done

if [ "${#md_files[@]}" -eq 0 ] && [ "${#config_files[@]}" -eq 0 ] &&
	[ "${#bash_files[@]}" -eq 0 ] && [ "${#python_files[@]}" -eq 0 ]; then
	exit 0
fi

status=0

if [ "${#md_files[@]}" -gt 0 ]; then
	if ! command -v mdl >/dev/null 2>&1; then
		gem_bin="not available (ruby not found)"
		if command -v ruby >/dev/null 2>&1; then
			gem_bin="$(ruby -e 'puts Gem.user_dir')/bin"
		fi
		printf 'pre-commit: mdl not found on PATH (gem install --user-install mdl, then add %s to PATH)\n' \
			"$gem_bin" >&2
		status=1
	else
		# See lint-markdown.sh for why: don't trust the script's own python3
		# shebang -- Windows's App Execution Alias stub can shadow a real
		# interpreter.
		py=""
		for candidate in python3 python; do
			if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "" >/dev/null 2>&1; then
				py="$candidate"
				break
			fi
		done
		if [ -z "$py" ]; then
			printf 'pre-commit: no working python3/python interpreter found on PATH\n' >&2
			status=1
		else
			mdl "${md_files[@]}" || status=1
			"$py" "$repo_root/check-markdown-links.py" "${md_files[@]}" || status=1
		fi
	fi
fi

if [ "${#config_files[@]}" -gt 0 ]; then
	"$repo_root/validate-config.sh" "${config_files[@]}" || status=1
fi

if [ "${#bash_files[@]}" -gt 0 ]; then
	"$repo_root/lint-bash.sh" "${bash_files[@]}" || status=1
fi

if [ "${#python_files[@]}" -gt 0 ]; then
	"$repo_root/lint-python.sh" "${python_files[@]}" || status=1
fi

exit "$status"
